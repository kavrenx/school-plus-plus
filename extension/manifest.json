{
  "manifest_version": 3,
  "name": "School++ — синхронизация дневника",
  "short_name": "School++",
  "version": "1.0.1",
  "description": "Переносит данные из электронного дневника пользователя в School++.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://diary.e-schools.by/*",
    "https://schoolpp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Синхронизировать с School++",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://diary.e-schools.by/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://diary.e-schools.by/*"],
      "js": [
        "shared/e-schools-parser.js",
        "shared/sync-engine.js",
        "content/e-schools.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://schoolpp.com/*"],
      "js": ["content/schoolpp.js"],
      "run_at": "document_start"
    }
  ]
}
